LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
LLM_MODEL=YOUR_MODEL_NAME
LLM_API_KEY=YOUR_API_KEY
LLM_MAX_TOKENS=1000
MAX_REWRITES=2
PROMPT_STYLE=full
# Optional: allowed browser origins for the Next.js UI, comma-separated
CORS_ORIGINS=
